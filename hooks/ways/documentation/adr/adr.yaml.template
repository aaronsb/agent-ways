# ADR Configuration
# Defines domain numbering and validation rules.
# Used by: docs/scripts/adr  — and, if the doc catalog is installed,
#          docs/scripts/{doc,doclint}: prose docs share these same domain bands
#          (the "shared first octet"; catalog ids are DD.NNN.P). See ADR-302.
#
# Customize domains for your project. Each domain reserves a number range.
# New ADRs get the next available number in their domain.

# Project name (used in generated index)
project_name: My Project

# Domain Number Series
domains:
  core:
    range: [100, 199]
    name: Core
    description: Core architecture, patterns, data model
    folder: core

  infra:
    range: [200, 299]
    name: Infrastructure
    description: Deployment, hosting, CI/CD, networking
    folder: infrastructure

  api:
    range: [300, 399]
    name: API
    description: Endpoints, protocols, versioning
    folder: api

  security:
    range: [400, 499]
    name: Security
    description: Authentication, authorization, secrets
    folder: security

# The record contract (ADR-304). With `contract: adr/v1`, records are typed:
# each declares a kind, and a decision names a verb, a capability and its
# basis. Delete this line and the v1 blocks below to stay on adr/v0.
contract: adr/v1

kinds:
  decision:
    verb: required
    requires: [capability, basis, agent]
    sections: [Summary]
    edges: { supersedes: decision, amends: decision, extends: decision, basis: [decision, spec, evidence] }
  spec:
    verb: forbidden
    requires: [capability]
    edges: { supersedes: spec, decided_by: decision }
  evidence:
    verb: forbidden
    requires: [capability]
    edges: { supersedes: evidence }

# What the project does, one line each. A record's `capability` names one of
# these, and a decision adds, cuts, changes or constrains them. Replace the
# placeholder with the project's own list.
capabilities:
  core: The project's core behaviour (placeholder; replace)

# Valid ADR statuses (adr/v0 records)
statuses:
  - Draft         # Initial creation, not yet proposed
  - Proposed      # Under discussion/review
  - Accepted      # Approved and ready for implementation
  - Superseded    # Replaced by another ADR
  - Deprecated    # No longer relevant
  - Rejected      # Decided against; kept for the record

# Default values for new ADRs
defaults:
  deciders: []    # Add GitHub usernames: [alice, bob]. Empty = auto-detect from gh/git
  status: Draft

# Legacy ADR range (pre-domain numbering)
legacy:
  range: [1, 99]
  label: "Legacy"
  # retired: true   # Uncomment ONLY if the legacy range is VACATED (its ADRs
  #                 # were renumbered into domains). doclint then fails on any
  #                 # reference into the range. Leave off if the project still
  #                 # uses its legacy numbers (the common case).
  # defining_adr: ADR-NNN   # With retired: true, exempt the ADR that vacated the
  #                         # range — it names retired numbers legitimately.

# Viewer command for `adr view` (use {file} as placeholder)
# Options: cat {file}, glow {file}, bat {file}
viewer: cat {file}
