# Miami — original to agent-ways: Ocean Drive by day. Deco pastels on the
# ground (a Nagai sky to blush stucco), neon flamingo and pool turquoise.
THEME_NAME="miami"
THEME_LABEL="Miami"
THEME_KIND="light"
THEME_BACKGROUND="fill"
THEME_GRADIENT="vertical #d4efff #fff4ee #ffe6ee"

THEME_BG="#fff4ee"
THEME_FG="#0a1a33"
THEME_DIM="#716275"
THEME_SUBTLE="#ffd3e1"
THEME_ACCENT="#aa0050"
THEME_INFO="#005b7d"
THEME_OK="#00614b"
THEME_WARN="#b83d00"
THEME_ERR="#94001e"
THEME_ALT="#6729d1"

THEME_SELECTION="#c8f1ee"
THEME_RULE="#168a9c"

THEME_BORDER="double"
THEME_RULE_GLYPHS="─═"
THEME_MARK="▌"
THEME_PRESENCE="◆◇"
THEME_ORNAMENT="🦩"

THEME_EVENT_HEAD="☀"
THEME_EVENT_MARK="┊"
THEME_EVENT_MATCHED="✿"
THEME_EVENT_INJECTED="❀"
THEME_EVENT_SUPPRESSED="☂"
THEME_EVENT_REDISCLOSED="↻"

# The words Claude Code shows under this theme (ways-theme mod). This file
# is original to agent-ways, not a dotfiles palette: a table line does not
# source as shell.
[words]
spinner = ["Sunning", "Surfing", "Strolling", "Sipping", "Sparkling", "Drifting"]
done = ["Sunned", "Surfed", "Strolled", "Sipped"]

# Waypoints: the marks a way's cluster wears on the replay.

[[waypoints]]
glyph = "🦩"

[[waypoints]]
glyph = "🌺"

[[waypoints]]
glyph = "🐬"

[[waypoints]]
glyph = "🍹"

[[waypoints]]
glyph = "🌴"

[[waypoints]]
glyph = "🏄"

[[waypoints]]
glyph = "🐚"

[[waypoints]]
glyph = "🍊"

[[waypoints]]
glyph = "🌞"

[[waypoints]]
glyph = "🥥"
