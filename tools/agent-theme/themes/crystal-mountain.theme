# Crystal Mountain — original to agent-ways: high-altitude daylight on
# glacier ice and quartz. A ground from ice-blue sky through snow to a faint
# amethyst, gem tones for the roles, ridgeline rules and crystal marks.
THEME_NAME="crystal-mountain"
THEME_LABEL="Crystal Mountain"
THEME_KIND="light"
THEME_BACKGROUND="fill"
THEME_GRADIENT="vertical #e2effa #f8fbfd #f0eaf8"

THEME_BG="#f8fbfd"
THEME_FG="#141a2b"
THEME_DIM="#5d6378"
THEME_SUBTLE="#d3e2f0"
THEME_ACCENT="#1d4fb0"
THEME_INFO="#006678"
THEME_OK="#0b6b40"
THEME_WARN="#b33b00"
THEME_ERR="#9a0f3a"
THEME_ALT="#6a2ea8"

THEME_SELECTION="#d8e5f8"

THEME_BORDER="plain"
THEME_RULE_GLYPHS="⌃⋀"
THEME_MARK="⧫"
THEME_PRESENCE="✦✧"
THEME_ORNAMENT="❄"

THEME_EVENT_HEAD="✶"
THEME_EVENT_MARK="┊"
THEME_EVENT_MATCHED="❆"
THEME_EVENT_INJECTED="❅"
THEME_EVENT_SUPPRESSED="⋄"
THEME_EVENT_REDISCLOSED="⟲"

# The words Claude Code shows under this theme (ways-theme mod). This file
# is original to agent-ways, not a dotfiles palette: a table line does not
# source as shell.
[words]
spinner = ["Climbing", "Ascending", "Glinting", "Traversing", "Crystallizing", "Summiting"]
done = ["Climbed", "Crossed", "Crystallized", "Summited"]

# Waypoints: the marks a way's cluster wears on the replay.

[[waypoints]]
glyph = "❆"
fg = "#1d4fb0"

[[waypoints]]
glyph = "⟡"
fg = "#6a2ea8"

[[waypoints]]
glyph = "✶"
fg = "#0b6b40"

[[waypoints]]
glyph = "⧫"
fg = "#9a0f3a"

[[waypoints]]
glyph = "❅"
fg = "#006678"

[[waypoints]]
glyph = "✧"
fg = "#a86a00"

[[waypoints]]
glyph = "⬡"
fg = "#3b6fc4"

[[waypoints]]
glyph = "⋄"
fg = "#b0457a"

[[waypoints]]
glyph = "✦"
fg = "#4a5a78"

[[waypoints]]
glyph = "❖"
fg = "#00808a"
