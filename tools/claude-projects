#!/usr/bin/env python3
"""
claude-projects — enumerate, search, and summarize Claude Code projects

Usage:
    claude-projects                    # list all projects, most recent first
    claude-projects list               # same
    claude-projects list --active      # only projects with sessions
    claude-projects list --memory      # only projects with memory
    claude-projects list --stale       # empty projects (no sessions)
    claude-projects search <query>     # fuzzy search project paths
    claude-projects show <project>     # detailed view of one project
    claude-projects stats              # aggregate statistics
    claude-projects cleanup --dry-run  # show empty projects that could be removed
    claude-projects cleanup            # remove empty project directories
    claude-projects relocate OLD NEW   # preview moving session history to a new path
    claude-projects relocate OLD NEW --execute

Install:
    Symlinked onto PATH by scripts/install.sh, alongside the ways binaries.
"""

import argparse
import json
import os
import re
import shutil
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

PROJECTS_DIR = Path.home() / ".claude" / "projects"
HOME = str(Path.home())

def term_width():
    """Get terminal width, default 80."""
    try:
        return os.get_terminal_size().columns
    except (ValueError, OSError):
        return 80

_ANSI_RE = re.compile(r'\033\[[0-9;]*m')

def vlen(s):
    """Visible length of a string (ignoring ANSI escape codes)."""
    return len(_ANSI_RE.sub('', s))

def rpad(s, width):
    """Right-pad string to width, accounting for ANSI codes."""
    return s + ' ' * max(0, width - vlen(s))

def lpad(s, width):
    """Left-pad (right-align) string to width, accounting for ANSI codes."""
    return ' ' * max(0, width - vlen(s)) + s

# ── Colors ──────────────────────────────────────────────────────────────────

USE_COLOR = sys.stdout.isatty()

def c(code, text):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text

def bold(t):   return c("1", t)
def dim(t):    return c("2", t)
def cyan(t):   return c("36", t)
def green(t):  return c("32", t)
def yellow(t): return c("33", t)
def red(t):    return c("31", t)
def mag(t):    return c("35", t)

def as_file_url(display_path):
    """Convert display path to file:// URL for terminal auto-link detection."""
    expanded = display_path.replace("~", HOME, 1) if display_path.startswith("~") else display_path
    return f"file://{expanded}"

# ── Data helpers ────────────────────────────────────────────────────────────

def decode_project_path(dirname):
    """Best-effort reverse of Claude's path encoding (/ and . → -)."""
    # Try sessions-index first for the real path
    idx = PROJECTS_DIR / dirname / "sessions-index.json"
    if idx.exists():
        try:
            data = json.loads(idx.read_text())
            entries = data.get("entries", [])
            if entries:
                pp = entries[0].get("projectPath", "")
                if pp:
                    return pp.replace(HOME, "~")
        except (json.JSONDecodeError, KeyError):
            pass

    # Fallback: heuristic decode
    # -home-aaron-Projects-foo → ~/Projects/foo
    name = dirname.lstrip("-")
    if name.startswith("home-"):
        parts = name.split("-")
        # Skip home-username
        if len(parts) >= 2:
            remainder = parts[2:]  # after home-aaron
            return "~/" + "/".join(remainder) if remainder else "~"
    return dirname


def scan_project(dirname):
    """Gather metadata for a single project directory."""
    proj_dir = PROJECTS_DIR / dirname
    info = {
        "dirname": dirname,
        "path": decode_project_path(dirname),
        "sessions": 0,
        "jsonl_files": 0,
        "jsonl_bytes": 0,
        "has_memory": False,
        "memory_files": 0,
        "last_active": None,
        "first_active": None,
        "last_summary": None,
        "last_branch": None,
        "recent_prompts": [],
    }

    # Sessions index
    idx_file = proj_dir / "sessions-index.json"
    if idx_file.exists():
        try:
            data = json.loads(idx_file.read_text())
            entries = data.get("entries", [])
            info["sessions"] = len(entries)
            if entries:
                # Sort by modified date
                sorted_entries = sorted(entries, key=lambda e: e.get("modified", ""), reverse=True)
                latest = sorted_entries[0]
                info["last_active"] = latest.get("modified", "")[:10]
                info["last_summary"] = latest.get("summary", "")
                info["last_branch"] = latest.get("gitBranch", "")

                oldest = sorted_entries[-1]
                info["first_active"] = oldest.get("created", "")[:10]

                # Recent prompts (last 3 sessions)
                for e in sorted_entries[:3]:
                    fp = e.get("firstPrompt", "")
                    if fp:
                        info["recent_prompts"].append(fp[:80])
        except (json.JSONDecodeError, KeyError):
            pass

    # JSONL files (transcripts)
    jsonl_files = list(proj_dir.glob("*.jsonl"))
    info["jsonl_files"] = len(jsonl_files)
    info["jsonl_bytes"] = sum(f.stat().st_size for f in jsonl_files)

    # If no session index, try to get last active from file mtime
    if not info["last_active"] and jsonl_files:
        newest = max(jsonl_files, key=lambda f: f.stat().st_mtime)
        info["last_active"] = datetime.fromtimestamp(newest.stat().st_mtime).strftime("%Y-%m-%d")

    # Memory
    mem_dir = proj_dir / "memory"
    if mem_dir.is_dir():
        mem_files = [f for f in mem_dir.iterdir() if f.is_file() and f.name != ".gitkeep"]
        info["has_memory"] = len(mem_files) > 0
        info["memory_files"] = len(mem_files)

    return info


def scan_all():
    """Scan all project directories."""
    if not PROJECTS_DIR.exists():
        return []

    projects = []
    for d in PROJECTS_DIR.iterdir():
        if d.is_dir() and not d.name.startswith("."):
            projects.append(scan_project(d.name))

    # Sort by last active (most recent first), then by name
    projects.sort(key=lambda p: p.get("last_active") or "0000", reverse=True)
    return projects


def fmt_bytes(n):
    if n >= 1_000_000_000:
        return f"{n/1_000_000_000:.1f}G"
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n/1_000:.0f}K"
    return f"{n}B"


def age_str(date_str):
    """Convert a date string to a relative age like '3d', '2w', '5mo'."""
    if not date_str:
        return ""
    try:
        d = datetime.fromisoformat(date_str.replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        now = datetime.now(timezone.utc)
        delta = now - d
        days = delta.days
        if days == 0:
            return "today"
        if days == 1:
            return "1d"
        if days < 7:
            return f"{days}d"
        if days < 30:
            return f"{days // 7}w"
        if days < 365:
            return f"{days // 30}mo"
        return f"{days // 365}y"
    except (ValueError, TypeError):
        return ""

# ── Commands ────────────────────────────────────────────────────────────────

def cmd_list(args):
    projects = scan_all()

    if args.active:
        projects = [p for p in projects if p["sessions"] > 0 or p["jsonl_files"] > 0]
    elif args.memory:
        projects = [p for p in projects if p["has_memory"]]
    elif args.stale:
        projects = [p for p in projects if p["sessions"] == 0 and p["jsonl_files"] == 0]

    if not projects:
        print("No matching projects found.")
        return

    # Dynamic column layout based on terminal width
    tw = term_width()
    # Fixed columns: 2 indent + Sessions(8) + Size(6) + Last(7) + Memory(6) + spacing(5) = 34
    fixed = 36
    path_w = max(20, tw - fixed)

    # Header
    print(f"\n{bold('Claude Code Projects')}  ({len(projects)} shown)\n")
    print(f"  {'Project':<{path_w}} {'Sessions':>8} {'Size':>6} {'Last':>7} {'Memory':>6}")
    print(f"  {'─' * path_w} {'─' * 8} {'─' * 6} {'─' * 7} {'─' * 6}")

    show_urls = getattr(args, "urls", False)

    for p in projects:
        path = p["path"]
        if len(path) > path_w:
            path = "…" + path[-(path_w - 1):]

        sess = str(p["sessions"]) if p["sessions"] else dim(str(p["jsonl_files"]) + "t") if p["jsonl_files"] else dim("–")
        size = fmt_bytes(p["jsonl_bytes"]) if p["jsonl_bytes"] else dim("–")
        age = age_str(p["last_active"]) if p["last_active"] else dim("–")
        mem = green("●") if p["has_memory"] else dim("·")

        # Color age
        if age in ("today", "1d"):
            age = green(age)
        elif age and age[-1] in ("d", "w"):
            age = cyan(age)
        elif age and age[-1] == "o":
            age = yellow(age)
        elif age:
            age = dim(age)

        if show_urls:
            # Two-line format: clickable URL + metadata
            print(f"  {as_file_url(p['path'])}")
            print(f"    {lpad(sess, 8)} {lpad(size, 6)} {lpad(age, 7)} {lpad(mem, 6)}")
        else:
            print(f"  {rpad(path, path_w)} {lpad(sess, 8)} {lpad(size, 6)} {lpad(age, 7)} {lpad(mem, 6)}")

    print()


def cmd_search(args):
    query = args.query.lower()
    projects = scan_all()
    deep = getattr(args, "deep", False)

    matches = []
    for p in projects:
        score = 0
        context_snippets = []
        path_lower = p["path"].lower()
        dirname_lower = p["dirname"].lower()

        # Exact substring
        if query in path_lower or query in dirname_lower:
            score += 10

        # Word match
        for word in query.split():
            if word in path_lower:
                score += 5

        # Summary match (search all summaries from sessions-index)
        idx_file = PROJECTS_DIR / p["dirname"] / "sessions-index.json"
        if idx_file.exists():
            try:
                data = json.loads(idx_file.read_text())
                for entry in data.get("entries", []):
                    summary = (entry.get("summary") or "").lower()
                    first_prompt = (entry.get("firstPrompt") or "").lower()
                    if query in summary:
                        score += 5
                        context_snippets.append(entry.get("summary", "")[:80])
                    elif query in first_prompt:
                        score += 3
                        context_snippets.append(entry.get("firstPrompt", "")[:80])
            except (json.JSONDecodeError, KeyError):
                pass
        else:
            # Fallback: check recent prompts
            for prompt in p.get("recent_prompts", []):
                if query in prompt.lower():
                    score += 2
                    context_snippets.append(prompt[:80])
                    break

        # Deep search: grep into transcript content
        if deep and score == 0:
            import subprocess
            proj_dir = PROJECTS_DIR / p["dirname"]
            try:
                result = subprocess.run(
                    ["grep", "-r", "-l", "-i", query, str(proj_dir)],
                    capture_output=True, text=True, timeout=5
                )
                if result.returncode == 0:
                    hit_count = len(result.stdout.strip().split("\n"))
                    score += min(hit_count, 5)  # cap deep match score
                    # Get a snippet from the first matching file
                    first_hit = result.stdout.strip().split("\n")[0]
                    if first_hit.endswith(".jsonl"):
                        snip = subprocess.run(
                            ["grep", "-i", "-m", "1", "-o", f".{{0,40}}{query}.{{0,40}}", first_hit],
                            capture_output=True, text=True, timeout=3
                        )
                        if snip.stdout.strip():
                            context_snippets.append(f"…{snip.stdout.strip()[:80]}…")
            except (subprocess.TimeoutExpired, OSError):
                pass

        if score > 0:
            matches.append((score, p, context_snippets))

    matches.sort(key=lambda x: x[0], reverse=True)

    if not matches:
        print(f"No projects matching '{args.query}'" +
              (" (try --deep to search transcript content)" if not deep else ""))
        return

    mode = bold("Deep search") if deep else bold("Search")
    print(f"\n{mode}: {args.query}  ({len(matches)} matches)\n")
    for score, p, snippets in matches[:15]:
        path = p["path"]
        sess = f"{p['sessions']}s" if p["sessions"] else f"{p['jsonl_files']}t" if p["jsonl_files"] else "–"
        age = age_str(p["last_active"]) or "–"
        print(f"  {cyan(as_file_url(p['path']))}")
        print(f"    {dim(sess)} · {dim(age)}")
        for snip in snippets[:2]:
            print(f"    {dim('›')} {snip}")
    print()


def cmd_show(args):
    query = args.project.lower()
    projects = scan_all()

    # Find best match
    match = None
    for p in projects:
        if query in p["path"].lower() or query in p["dirname"].lower():
            match = p
            break

    if not match:
        print(f"No project matching '{args.project}'")
        return

    p = match
    print(f"\n{bold(as_file_url(p['path']))}")
    print(f"  {dim('Dir:')} {p['dirname']}")
    print()

    if p["first_active"]:
        print(f"  {dim('First session:')} {p['first_active']}")
    if p["last_active"]:
        print(f"  {dim('Last active:')}  {p['last_active']} ({age_str(p['last_active'])})")
    if p["last_branch"]:
        print(f"  {dim('Last branch:')}  {p['last_branch']}")
    print()

    print(f"  {dim('Sessions:')}     {p['sessions']}")
    print(f"  {dim('Transcripts:')}  {p['jsonl_files']}  ({fmt_bytes(p['jsonl_bytes'])})")
    print(f"  {dim('Memory:')}       {'yes' if p['has_memory'] else 'no'}" +
          (f" ({p['memory_files']} files)" if p['memory_files'] else ""))
    print()

    if p.get("last_summary"):
        print(f"  {dim('Last summary:')} {p['last_summary']}")
        print()

    if p.get("recent_prompts"):
        print(f"  {dim('Recent first prompts:')}")
        for prompt in p["recent_prompts"]:
            print(f"    {dim('›')} {prompt}")
        print()

    # Show session list from index if available
    idx_file = PROJECTS_DIR / p["dirname"] / "sessions-index.json"
    if idx_file.exists():
        try:
            data = json.loads(idx_file.read_text())
            entries = sorted(data.get("entries", []),
                           key=lambda e: e.get("modified", ""), reverse=True)
            if entries:
                print(f"  {dim('Sessions:')}")
                for e in entries[:10]:
                    date = e.get("modified", "")[:10]
                    msgs = e.get("messageCount", "?")
                    branch = e.get("gitBranch", "")
                    summary = e.get("summary", "")[:50]
                    sidechain = " ⑂" if e.get("isSidechain") else ""
                    print(f"    {dim(date)}  {msgs:>3} msgs  {dim(branch):<20}{sidechain}")
                    if summary:
                        print(f"      {dim(summary)}")
                if len(entries) > 10:
                    print(f"    {dim(f'… +{len(entries) - 10} more')}")
                print()
        except (json.JSONDecodeError, KeyError):
            pass


def cmd_stats(args):
    projects = scan_all()

    total = len(projects)
    with_sessions = sum(1 for p in projects if p["sessions"] > 0)
    with_transcripts = sum(1 for p in projects if p["jsonl_files"] > 0)
    with_memory = sum(1 for p in projects if p["has_memory"])
    empty = sum(1 for p in projects if p["sessions"] == 0 and p["jsonl_files"] == 0)
    total_sessions = sum(p["sessions"] for p in projects)
    total_transcripts = sum(p["jsonl_files"] for p in projects)
    total_bytes = sum(p["jsonl_bytes"] for p in projects)

    print(f"\n{bold('Claude Code Project Statistics')}\n")
    print(f"  Projects:          {total}")
    print(f"    with sessions:   {with_sessions}")
    print(f"    with transcripts:{with_transcripts}")
    print(f"    with memory:     {with_memory}")
    print(f"    empty:           {yellow(str(empty))}")
    print()
    print(f"  Total sessions:    {total_sessions}")
    print(f"  Total transcripts: {total_transcripts}")
    print(f"  Total disk:        {fmt_bytes(total_bytes)}")
    print()

    # Top projects by size
    by_size = sorted(projects, key=lambda p: p["jsonl_bytes"], reverse=True)[:10]
    print(f"  {dim('Top by disk usage:')}")
    for p in by_size:
        if p["jsonl_bytes"] == 0:
            break
        print(f"    {fmt_bytes(p['jsonl_bytes']):>6}  {p['path']}")
    print()

    # Most active
    by_sessions = sorted(projects, key=lambda p: p["sessions"], reverse=True)[:10]
    print(f"  {dim('Top by session count:')}")
    for p in by_sessions:
        if p["sessions"] == 0:
            break
        print(f"    {p['sessions']:>4}  {p['path']}")
    print()


def cmd_cleanup(args):
    projects = scan_all()
    empty = [p for p in projects if p["sessions"] == 0 and p["jsonl_files"] == 0]

    if not empty:
        print("No empty projects to clean up.")
        return

    print(f"\n{bold('Empty projects')} ({len(empty)} found)")
    print(f"  {dim('These are metadata entries in ~/.claude/projects/, NOT your actual project directories.')}\n")
    for p in empty:
        print(f"  {dim(p['path'])}  {dim('→')}  {dim(str(PROJECTS_DIR / p['dirname']))}")

    if args.dry_run:
        print(f"\n  {dim('(dry run — pass without --dry-run to remove)')}")
        return

    print()
    confirm = input(f"  Remove {len(empty)} empty entries from ~/.claude/projects/? [y/N] ")
    if confirm.lower() != "y":
        print("  Cancelled.")
        return

    removed = 0
    for p in empty:
        proj_dir = PROJECTS_DIR / p["dirname"]
        try:
            # Only remove if truly empty (no files at all, or just empty subdirs)
            contents = list(proj_dir.rglob("*"))
            files = [c for c in contents if c.is_file()]
            if not files:
                import shutil
                shutil.rmtree(proj_dir)
                removed += 1
                print(f"  {dim('removed')} {p['path']}")
            else:
                print(f"  {yellow('skipped')} {p['path']} (has {len(files)} files)")
        except OSError as e:
            print(f"  {red('error')} {p['path']}: {e}")

    print(f"\n  Removed {removed} directories.")

def cmd_hygiene(args):
    """Session hygiene: find orphaned transcripts, oversized sessions, disk hogs."""
    projects = scan_all()
    import shutil

    total_disk = sum(p["jsonl_bytes"] for p in projects)
    issues = []

    for p in projects:
        proj_dir = PROJECTS_DIR / p["dirname"]

        # Orphaned transcripts: JSONL files not in sessions-index
        idx_file = proj_dir / "sessions-index.json"
        indexed_sessions = set()
        if idx_file.exists():
            try:
                data = json.loads(idx_file.read_text())
                for entry in data.get("entries", []):
                    sid = entry.get("sessionId", "")
                    if sid:
                        indexed_sessions.add(sid)
            except (json.JSONDecodeError, KeyError):
                pass

        jsonl_files = list(proj_dir.glob("*.jsonl"))
        for jf in jsonl_files:
            sid = jf.stem
            size = jf.stat().st_size
            if sid not in indexed_sessions and indexed_sessions:
                issues.append({
                    "type": "orphan",
                    "project": p["path"],
                    "file": jf.name,
                    "size": size,
                    "path": jf,
                })

            # Oversized transcripts (> 10MB)
            if size > 10_000_000:
                issues.append({
                    "type": "large",
                    "project": p["path"],
                    "file": jf.name,
                    "size": size,
                    "path": jf,
                })

        # Empty session dirs (worktree artifacts)
        for d in proj_dir.iterdir():
            if d.is_dir() and d.name != "memory":
                contents = list(d.iterdir())
                if not contents:
                    issues.append({
                        "type": "empty_dir",
                        "project": p["path"],
                        "file": d.name,
                        "size": 0,
                        "path": d,
                    })

    if not issues:
        print(f"\n{green('All clean!')} No hygiene issues found across {len(projects)} projects.\n")
        return

    # Group by type
    orphans = [i for i in issues if i["type"] == "orphan"]
    large = [i for i in issues if i["type"] == "large"]
    empty_dirs = [i for i in issues if i["type"] == "empty_dir"]

    print(f"\n{bold('Session Hygiene Report')}\n")
    print(f"  Total disk usage: {fmt_bytes(total_disk)}")
    print(f"  Projects scanned: {len(projects)}")
    print()

    if large:
        large.sort(key=lambda x: x["size"], reverse=True)
        large_total = sum(i["size"] for i in large)
        print(f"  {yellow('Large transcripts')} (>10MB): {len(large)}  ({fmt_bytes(large_total)} total)")
        for i in large[:10]:
            print(f"    {fmt_bytes(i['size']):>6}  {i['project']}")
            print(f"           {dim(i['file'])}")
        if len(large) > 10:
            print(f"    {dim(f'… +{len(large) - 10} more')}")
        print()

    if orphans:
        orphan_total = sum(i["size"] for i in orphans)
        print(f"  {yellow('Orphaned transcripts')} (not in sessions-index): {len(orphans)}  ({fmt_bytes(orphan_total)})")
        # Group by project
        by_proj = {}
        for i in orphans:
            by_proj.setdefault(i["project"], []).append(i)
        for proj, items in sorted(by_proj.items()):
            proj_total = sum(i["size"] for i in items)
            print(f"    {proj}  ({len(items)} files, {fmt_bytes(proj_total)})")
        print()

    if empty_dirs:
        print(f"  {dim('Empty session dirs')}: {len(empty_dirs)}")
        print()

    if args.dry_run:
        reclaimable = sum(i["size"] for i in orphans)
        print(f"  Reclaimable from orphans: {fmt_bytes(reclaimable)}")
        print(f"  {dim('(pass without --dry-run to clean up)')}")
        return

    # Interactive cleanup
    if orphans:
        orphan_total = sum(i["size"] for i in orphans)
        confirm = input(f"  Remove {len(orphans)} orphaned transcripts from ~/.claude/projects/ ({fmt_bytes(orphan_total)})? [y/N] ")
        if confirm.lower() == "y":
            removed = 0
            freed = 0
            for i in orphans:
                try:
                    i["path"].unlink()
                    removed += 1
                    freed += i["size"]
                except OSError as e:
                    print(f"  {red('error')} {i['path']}: {e}")
            print(f"  Removed {removed} files, freed {fmt_bytes(freed)}")

    if empty_dirs:
        confirm = input(f"  Remove {len(empty_dirs)} empty session directories? [y/N] ")
        if confirm.lower() == "y":
            for i in empty_dirs:
                try:
                    i["path"].rmdir()
                except OSError:
                    pass
            print(f"  Cleaned up {len(empty_dirs)} directories")

    print()


# ── Relocate ────────────────────────────────────────────────────────────────

# Claude encodes a project path into a directory name by collapsing every
# non-alphanumeric character to "-". That is lossy and irreversible ("/a/b_c"
# and "/a/b-c" both encode to "-a-b-c"), which is why relocate takes real paths
# and why the true path is carried in sessions-index.json rather than decoded.
_SLUG_RE = re.compile(r"[^a-zA-Z0-9]")

CLAUDE_JSON = Path.home() / ".claude.json"
HISTORY_FILE = Path.home() / ".claude" / "history.jsonl"

# A transcript touched this recently probably belongs to a live session, which
# appends to the file we are about to rewrite.
LIVE_SESSION_WINDOW = 120  # seconds


def encode_project_path(path):
    """Forward of Claude's path encoding: every non-alphanumeric char → '-'."""
    return _SLUG_RE.sub("-", path)


def norm_path(p):
    """Absolute, ~-expanded, no trailing slash."""
    return os.path.abspath(os.path.expanduser(p)).rstrip("/") or "/"


def remap(value, old, new):
    """Remap `value` if it is `old` or lives under it. None if unaffected."""
    if not isinstance(value, str):
        return None
    if value == old:
        return new
    if value.startswith(old + "/"):
        return new + value[len(old):]
    return None


def backup_file(path):
    """Timestamped sibling copy. Returns the backup path."""
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = path.with_name(f"{path.name}.bak-relocate-{stamp}")
    shutil.copy2(path, dest)
    return dest


def rewrite_jsonl(path, field, old, new, apply):
    """Remap a top-level string field across a JSONL file.

    Lines that do not mention `old` are copied byte-for-byte, so only genuinely
    affected records are ever re-serialized. Returns (changed, residual), where
    residual counts lines that still mention the old path afterwards (message
    text, file paths in tool results — content this command deliberately does
    not touch).
    """
    changed = residual = 0
    tmp = path.with_name(path.name + ".relocate-tmp")
    out = tmp.open("w", encoding="utf-8", errors="surrogateescape") if apply else None
    try:
        with path.open("r", encoding="utf-8", errors="surrogateescape") as fh:
            for line in fh:
                if old not in line:
                    if out:
                        out.write(line)
                    continue
                try:
                    obj = json.loads(line)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    obj = None
                if isinstance(obj, dict):
                    mapped = remap(obj.get(field), old, new)
                else:
                    mapped = None
                if mapped is None:
                    residual += 1
                    if out:
                        out.write(line)
                    continue
                obj[field] = mapped
                changed += 1
                rendered = json.dumps(obj, separators=(",", ":"), ensure_ascii=False)
                if old in rendered:
                    residual += 1
                if out:
                    out.write(rendered + "\n")
    except Exception:
        if out:
            out.close()
        tmp.unlink(missing_ok=True)
        raise
    if out:
        out.close()
        # Keep mtime: project listings sort by it, and relocating is not activity.
        shutil.copystat(path, tmp)
        os.replace(tmp, path)
    return changed, residual


def rewrite_sessions_index(idx, old, new, old_dir, new_dir, apply):
    """Remap projectPath / cwd / originalPath, plus fullPath (which embeds the slug)."""
    try:
        raw = idx.read_text()
        data = json.loads(raw)
    except (OSError, json.JSONDecodeError):
        return 0

    n = 0
    mapped = remap(data.get("originalPath"), old, new)
    if mapped is not None:
        data["originalPath"] = mapped
        n += 1
    for entry in data.get("entries", []):
        if not isinstance(entry, dict):
            continue
        for key in ("projectPath", "cwd"):
            mapped = remap(entry.get(key), old, new)
            if mapped is not None:
                entry[key] = mapped
                n += 1
        mapped = remap(entry.get("fullPath"), old_dir, new_dir)
        if mapped is not None:
            entry["fullPath"] = mapped
            n += 1

    if apply and n:
        indent = 2 if "\n  " in raw else None
        sep = None if indent else (",", ":")
        idx.write_text(json.dumps(data, indent=indent, separators=sep, ensure_ascii=False))
    return n


def rewrite_claude_json(old, new, merge, apply):
    """Rename the ~/.claude.json projects key, preserving key order.

    Returns (status, note) where status is one of: missing, absent, conflict, ok.
    """
    if not CLAUDE_JSON.exists():
        return "missing", None
    try:
        data = json.loads(CLAUDE_JSON.read_text())
    except (OSError, json.JSONDecodeError) as e:
        return "missing", str(e)

    projects = data.get("projects")
    if not isinstance(projects, dict) or old not in projects:
        return "absent", None
    if new in projects and not merge:
        return "conflict", None

    # Rebuild in place so the relocated project keeps its position in the file.
    rebuilt = {}
    for k, v in projects.items():
        if k == old:
            rebuilt[new] = v
        elif k == new:
            continue  # superseded by the relocated entry (--merge)
        else:
            rebuilt[k] = v
    data["projects"] = rebuilt

    if apply:
        backup_file(CLAUDE_JSON)
        tmp = CLAUDE_JSON.with_name(CLAUDE_JSON.name + ".relocate-tmp")
        tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False))
        os.replace(tmp, CLAUDE_JSON)
    return "ok", None


def cmd_relocate(args):
    """Move a project's session history from one working directory to another."""
    apply = args.execute
    old = norm_path(args.old_path)
    new = norm_path(args.new_path)

    if old == new:
        print(f"  {red('error')} old and new paths are identical: {old}")
        sys.exit(1)

    old_slug = encode_project_path(old)
    new_slug = encode_project_path(new)
    old_dir = PROJECTS_DIR / old_slug
    new_dir = PROJECTS_DIR / new_slug

    if not old_dir.is_dir():
        print(f"\n  {red('No session history for')} {old}")
        print(f"  {dim('expected')} {old_dir}\n")
        stem = old.rsplit("/", 1)[-1].lower()
        near = [d.name for d in PROJECTS_DIR.iterdir()
                if d.is_dir() and stem and stem[:6] in d.name.lower()] \
            if PROJECTS_DIR.is_dir() else []
        if near:
            print(f"  {dim('Similar project directories:')}")
            for n in near[:8]:
                print(f"    {n}")
            print()
        sys.exit(1)

    transcripts = sorted(old_dir.glob("*.jsonl"))

    # ── Plan ────────────────────────────────────────────────────────────────
    print(f"\n{bold('Relocate project')}")
    print(f"  {dim('from')}  {cyan(old)}   {dim(old_slug)}")
    print(f"  {dim('to')}    {green(new)}   {dim(new_slug)}")
    print()

    warnings = []
    if os.path.exists(new) and not os.path.isdir(new):
        print(f"  {red('error')} {new} exists but is not a directory")
        sys.exit(1)
    # There is nothing to resume into if the working directory is missing, so
    # create it rather than leaving the relocation half-useful.
    create_target = not os.path.isdir(new)

    live = [t for t in transcripts
            if time.time() - t.stat().st_mtime < LIVE_SESSION_WINDOW]
    if live:
        warnings.append(f"{len(live)} transcript(s) modified in the last "
                        f"{LIVE_SESSION_WINDOW}s — a session may be live in this project")

    merging = new_dir.exists() and new_slug != old_slug
    if merging and not args.merge:
        warnings.append(f"{new_dir.name} already exists — pass --merge to combine, "
                        f"or relocate that project away first")

    if create_target:
        print(f"  {dim('workdir')}     create {new} {dim('(does not exist yet)')}")

    # Directory move
    if new_slug == old_slug:
        print(f"  {dim('directory')}   unchanged {dim('(both paths encode to the same slug)')}")
    elif merging:
        print(f"  {dim('directory')}   {yellow('merge')} into existing {new_dir.name}")
    else:
        print(f"  {dim('directory')}   rename → {new_dir.name}")

    # Transcripts
    total_changed = total_residual = 0
    if args.keep_transcript_cwd:
        print(f"  {dim('transcripts')} {dim('skipped (--keep-transcript-cwd)')}")
    else:
        for t in transcripts:
            ch, res = rewrite_jsonl(t, "cwd", old, new, apply=False)
            total_changed += ch
            total_residual += res
        print(f"  {dim('transcripts')} {total_changed} cwd field(s) across "
              f"{len(transcripts)} file(s)")

    # sessions-index
    idx = old_dir / "sessions-index.json"
    idx_n = rewrite_sessions_index(idx, old, new, str(old_dir), str(new_dir), apply=False) \
        if idx.exists() else 0
    print(f"  {dim('index')}       {idx_n} field(s) in sessions-index.json"
          if idx.exists() else f"  {dim('index')}       {dim('none')}")

    # ~/.claude.json
    cj_status, cj_note = rewrite_claude_json(old, new, args.merge, apply=False)
    cj_label = {
        "ok": "projects key renamed",
        "absent": dim("no entry for this path"),
        "conflict": yellow(f"entry for {new} already exists — pass --merge to supersede it"),
        "missing": dim(f"unreadable ({cj_note})" if cj_note else "not found"),
    }[cj_status]
    print(f"  {dim('config')}      ~/.claude.json: {cj_label}")

    # history.jsonl
    hist_n = 0
    if HISTORY_FILE.exists():
        hist_n, _ = rewrite_jsonl(HISTORY_FILE, "project", old, new, apply=False)
    print(f"  {dim('history')}     {hist_n} prompt(s) in history.jsonl")

    if total_residual:
        print(f"\n  {dim('note')} {total_residual} line(s) still mention the old path in "
              f"message text or tool output.")
        print(f"       {dim('Those are a record of what happened and are left as-is.')}")

    for w in warnings:
        print(f"\n  {yellow('warning')} {w}")

    if not apply:
        print(f"\n  {dim('Preview only — re-run with --execute to apply.')}\n")
        return

    if live and not args.force:
        print(f"\n  {red('Refusing to rewrite transcripts while a session may be live.')}")
        print(f"  {dim('Exit that session, or pass --force if you know it is idle.')}\n")
        sys.exit(1)
    if merging and not args.merge:
        print(f"\n  {red('Refusing to overwrite an existing project directory.')}\n")
        sys.exit(1)

    # ── Execute ─────────────────────────────────────────────────────────────
    # Move first: a rename is atomic and trivially reversible, so if it fails
    # nothing else has been touched yet.
    print()
    if create_target:
        try:
            os.makedirs(new, exist_ok=True)
            print(f"  {green('created')} {new}")
        except OSError as e:
            print(f"  {red('error')} could not create {new}: {e}\n")
            sys.exit(1)

    work_dir = old_dir
    if new_slug != old_slug:
        try:
            if merging:
                new_dir.mkdir(parents=True, exist_ok=True)
                for item in list(old_dir.iterdir()):
                    target = new_dir / item.name
                    if target.exists():
                        print(f"  {yellow('skip')} {item.name} (already in target)")
                        continue
                    shutil.move(str(item), str(target))
                if not any(old_dir.iterdir()):
                    old_dir.rmdir()
            else:
                old_dir.rename(new_dir)
            work_dir = new_dir
            print(f"  {green('moved')} {old_dir.name} → {new_dir.name}")
        except OSError as e:
            print(f"  {red('error')} could not move project directory: {e}\n")
            sys.exit(1)

    if not args.keep_transcript_cwd:
        n = 0
        for t in sorted(work_dir.glob("*.jsonl")):
            try:
                ch, _ = rewrite_jsonl(t, "cwd", old, new, apply=True)
                n += ch
            except OSError as e:
                print(f"  {red('error')} {t.name}: {e}")
        print(f"  {green('rewrote')} {n} cwd field(s) in transcripts")

    idx = work_dir / "sessions-index.json"
    if idx.exists():
        n = rewrite_sessions_index(idx, old, new, str(old_dir), str(new_dir), apply=True)
        print(f"  {green('rewrote')} {n} field(s) in sessions-index.json")

    status, note = rewrite_claude_json(old, new, args.merge, apply=True)
    if status == "ok":
        print(f"  {green('renamed')} projects key in ~/.claude.json {dim('(backed up)')}")
    elif status == "conflict":
        print(f"  {yellow('skipped')} ~/.claude.json — an entry for {new} already exists")

    if HISTORY_FILE.exists():
        try:
            backup_file(HISTORY_FILE)
            n, _ = rewrite_jsonl(HISTORY_FILE, "project", old, new, apply=True)
            print(f"  {green('rewrote')} {n} prompt(s) in history.jsonl {dim('(backed up)')}")
        except OSError as e:
            print(f"  {red('error')} history.jsonl: {e}")

    print(f"\n  {bold('Done.')} Resume with:  {cyan(f'cd {new} && claude --resume')}")
    print(f"  {dim('To reverse:')} {dim(f'claude-projects relocate {new} {old} --execute')}\n")


# ── Main ────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="claude-projects",
        description="Enumerate, search, and summarize Claude Code projects",
    )
    sub = parser.add_subparsers(dest="command")

    # list
    p_list = sub.add_parser("list", aliases=["ls"], help="List projects")
    p_list.add_argument("--active", action="store_true", help="Only projects with sessions")
    p_list.add_argument("--memory", action="store_true", help="Only projects with memory")
    p_list.add_argument("--stale", action="store_true", help="Only empty projects")
    p_list.add_argument("--urls", action="store_true", help="Show clickable file:// URLs")

    # search
    p_search = sub.add_parser("search", aliases=["s", "find"], help="Search projects")
    p_search.add_argument("query", help="Search term")
    p_search.add_argument("--deep", action="store_true", help="Also search transcript content (slower)")

    # show
    p_show = sub.add_parser("show", aliases=["info"], help="Show project details")
    p_show.add_argument("project", help="Project path or name fragment")

    # stats
    sub.add_parser("stats", help="Aggregate statistics")

    # cleanup
    p_clean = sub.add_parser("cleanup", help="Remove empty project directories")
    p_clean.add_argument("--dry-run", action="store_true", help="Show what would be removed")

    # hygiene
    p_hyg = sub.add_parser("hygiene", help="Session hygiene: orphans, large files, disk usage")
    p_hyg.add_argument("--dry-run", action="store_true", help="Report only, don't remove")

    # relocate
    p_reloc = sub.add_parser(
        "relocate", aliases=["mv", "move"],
        help="Move a project's session history to a new working directory",
        description="Relocate session history from one working directory to another, "
                    "so sessions started in OLD_PATH resume in NEW_PATH. "
                    "Previews by default; pass --execute to apply.",
    )
    p_reloc.add_argument("old_path", help="Current project directory (where the sessions were started)")
    p_reloc.add_argument("new_path", help="New project directory (where you want to resume)")
    p_reloc.add_argument("--execute", action="store_true", help="Apply the changes (default is preview)")
    p_reloc.add_argument("--keep-transcript-cwd", action="store_true",
                         help="Leave transcripts byte-identical; only move metadata")
    p_reloc.add_argument("--merge", action="store_true",
                         help="Allow merging into an existing project at NEW_PATH")
    p_reloc.add_argument("--force", action="store_true",
                         help="Proceed even if a session looks live in this project")

    args = parser.parse_args()

    if args.command in ("list", "ls", None):
        if args.command is None:
            # Default: list with no filters
            args.active = False
            args.memory = False
            args.stale = False
            args.urls = False
        cmd_list(args)
    elif args.command in ("search", "s", "find"):
        cmd_search(args)
    elif args.command in ("show", "info"):
        cmd_show(args)
    elif args.command == "stats":
        cmd_stats(args)
    elif args.command == "cleanup":
        cmd_cleanup(args)
    elif args.command == "hygiene":
        cmd_hygiene(args)
    elif args.command in ("relocate", "mv", "move"):
        cmd_relocate(args)


if __name__ == "__main__":
    main()
