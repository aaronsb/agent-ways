{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "99",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "allow": [
      "Edit(~/.claude/**)",
      "Read",
      "Bash(~/.claude/hooks/ways/list-triggered.sh:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(uname:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(test:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(ln:*)",
      "Bash(touch:*)",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(attend:*)",
      "Bash(ways:*)",
      "Bash(ps:*)",
      "Bash(sha256sum:*)",
      "Bash(python3:*)",
      "Bash(env:*)",
      "Bash(id:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(command:*)",
      "Bash(curl:*)",
      "Bash(sudo:*)",
      "Bash(tar:*)",
      "Bash(printf:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(jq:*)",
      "Bash(adr:*)",
      "Bash(adr-tool:*)",
      "Bash(dotfiles:*)",
      "Bash(mmaid:*)",
      "Bash(kg:*)",
      "Bash(way-embed:*)",
      "Bash(way-match:*)",
      "Bash(attend-chat:*)",
      "Bash(gpg:*)",
      "Bash(gpgconf:*)",
      "Bash(base64:*)",
      "Bash(.claude/**:*)",
      "mcp__knowledge-graph__*",
      "mcp__jira-cloud__*",
      "mcp__chrome-devtools__*",
      "mcp__claude-in-chrome__*",
      "mcp__google-workspace__*",
      "mcp__slack-mcp__*",
      "mcp__thinking-strategies__*",
      "mcp__attend__*",
      "Bash(./dotfiles help)",
      "Bash(./dotfiles status)",
      "Bash(./dotfiles deploy:*)",
      "Bash(./dotfiles capture:*)",
      "Bash(~/.dotfiles/dotfiles status *)",
      "Bash(~/.dotfiles/dotfiles list *)",
      "Bash(~/.dotfiles/dotfiles deploy *)",
      "Bash(~/.dotfiles/dotfiles help *)",
      "Bash(~/.dotfiles/dotfiles capture *)",
      "Read(//usr/share/oh-my-posh/themes/**)",
      "Read(~/**)",
      "Bash(~/.dotfiles/dotfiles add *)",
      "Bash(posh-theme help *)",
      "Bash(posh-theme list *)",
      "Bash(posh-theme current *)",
      "Bash(posh-theme preview *)",
      "Bash(oh-my-posh --help)",
      "Bash(oh-my-posh get *)",
      "WebFetch(domain:ohmyposh.dev)",
      "Bash(oh-my-posh print *)",
      "Bash(oh-my-posh debug *)",
      "Bash(oh-my-posh config *)",
      "Bash(posh-theme fetch *)",
      "Bash(posh-theme preview-all *)",
      "Bash(zsh *)",
      "Bash(oh-my-posh init *)",
      "Bash(/bin/cat)",
      "Bash(/bin/cat -A)",
      "Bash(ssh *)",
      "Bash(sshpass -V)",
      "Bash(glow --version)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-setup.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/clear-markers.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/check-config-updates.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-state.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/bin/ways init",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/bin/ways corpus --if-stale --quiet",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/issues-pull.sh session-start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/clear-markers.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-state.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/issues-pull.sh session-start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-state.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/issues-pull.sh session-start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/clear-markers.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-state.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/bin/ways init",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/issues-pull.sh session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-file-pre.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-bash-pre.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/strip-session-link-pre.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/mark-tasks-active.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-task-pre.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "EnterPlanMode|ExitPlanMode|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-tool.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-prompt.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-state.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/issues-pull.sh prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/inject-subagent.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-post.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-queued.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue *)",
            "command": "${HOME}/.claude/hooks/ways/issues-pull.sh post-gh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__agent-ways__ways_read",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-pull.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "EnterPlanMode|ExitPlanMode|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-tool.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-post.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/check-response.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/attend-drain-stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/ways/issues-task-created.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
