%% Render: mmdc -i ADR-188-tool-call-lane-flow.mmd -o ADR-188-tool-call-lane-flow.svg -b transparent -c mermaid-config.json, then add xml:space="preserve" to the root svg element
flowchart TB
    subgraph BUILD["Build time"]
        direction TB
        T["tldr-pages extract<br>shipped data, CC BY 4.0 NOTICE"] --> CAT["Tool catalog, ADR-706<br>tool types + command entries"]
        A["Authored entries<br>our binaries, make targets, scripts"] --> CAT
        O["User and project overrides"] --> CAT
        W["Way corpus"] --> IDX["Edge index builder<br>optional"]
        CAT --> IDX
    end
    subgraph PRE["PreToolUse on a Bash call: the command never waits"]
        direction TB
        B["Hook adapter<br>check-tool.sh, ways hook tool"] --> REC["Session event record<br>ADR-415"]
        B --> P["Command describer, own crate<br>ordered segments: connector, role,<br>program, subcommand, flags, class,<br>description"]
        P --> RX["commands: regex<br>per operative segment"]
        RX --> NOW["Inject now<br>PreToolUse envelope"]
        P --> MT["Matcher<br>operative verbs + description<br>to candidate ways"]
        MT --> JOB["Deferred job<br>candidates + ordered block"]
    end
    subgraph LATE["Detached, then the next hook"]
        direction TB
        J{"Judge gate, ADR-196<br>one interface<br>reads: About to run: description,<br>then segments in order<br>with connectors and descriptions"}
        J -->|attend mod loaded| MH["Mod-host backend<br>$.model.complete<br>session's own account<br>strict JSON, validated"]
        J -->|no mod| KB["Key backend<br>ways agent, own API key<br>record_judgements tool"]
        MH -->|pass| STORE["Deferred result store<br>ADR-606"]
        KB -->|pass| STORE
        MH -->|fail or error| DROP["Held back, logged"]
        KB -->|fail or error| DROP
        STORE --> COL["Collector at the agent's next<br>PostToolUse or UserPromptSubmit"]
        COL -->|within budget| INJ["Inject with deferred header<br>way, Bash lane, segment, age"]
        COL -->|past budget| PTR["One-line pointer<br>to the result file"]
    end
    JOB --> J
    CAT -.->|command data| P
    CAT -.->|types, fields| B
    IDX -.->|edges| MT
    W -.->|aliases| MT
    REP["Lint and reach reports"] -.->|read| COL
    REP -.->|read| CAT
    classDef data fill:#2d8e5e,stroke:#4a5568,color:#ffffff
    classDef step fill:#2d7d9a,stroke:#4a5568,color:#ffffff
    classDef judge fill:#7c3aed,stroke:#4a5568,color:#ffffff
    classDef input fill:#fbbf24,stroke:#4a5568,color:#1a1a1a
    classDef out fill:#475569,stroke:#4a5568,color:#ffffff
    class T,A,O,W,CAT,IDX,REC,STORE data
    class P,RX,MT,JOB,COL,REP step
    class J,MH,KB judge
    class B input
    class NOW,INJ,PTR,DROP out
    style BUILD fill:#2d8e5e1a,stroke:#2d8e5e
    style PRE fill:#2d7d9a1a,stroke:#2d7d9a
    style LATE fill:#7c3aed1a,stroke:#7c3aed
